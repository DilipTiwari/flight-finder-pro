# Free startup mode: no paid flight API needed.
# Use this mode to launch the MVP, collect feedback and test SEO/traffic.
FLIGHT_DATA_PROVIDER=mock

# Optional later: switch to Amadeus only if you already have credentials.
# FLIGHT_DATA_PROVIDER=amadeus
# AMADEUS_CLIENT_ID=your_amadeus_api_key
# AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
# AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional analytics. Leave blank if you do not want GA4 yet.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Replace after joining an affiliate/travel partner program.
NEXT_PUBLIC_AFFILIATE_BASE_URL=https://example.com/affiliate-flight-search
NEXT_PUBLIC_SITE_URL=http://localhost:3000
